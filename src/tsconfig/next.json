{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "super-configs Next.js",
    "extends": "./react.json",
    "compilerOptions": {
        "allowJs": true,
        "incremental": true,
        "isolatedModules": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "moduleResolution": "Bundler",
        "noEmit": true,
        "plugins": [{ "name": "next" }],
        "resolveJsonModule": true
    }
}
