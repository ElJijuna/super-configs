{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "super-configs Bun",
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext"],
        "module": "Preserve",
        "moduleDetection": "force",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["bun"]
    }
}
