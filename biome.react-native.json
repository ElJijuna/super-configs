{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "extends": ["./biome.json"],
  "linter": {
    "domains": {
      "react": "recommended",
      "reactNative": "recommended"
    },
    "rules": {
      "nursery": {
        "noReactNativeDeepImports": "error",
        "noReactNativeLiteralColors": "warn",
        "noReactNativeRawText": "error",
        "useReactNativePlatformComponents": "error"
      }
    }
  }
}
